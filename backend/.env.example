APP_NAME=MurihSpace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://murihspace.com
FRONTEND_URL=https://app.murihspace.com
APP_DOWNLOAD_URL=https://apps.apple.com/app/murihspace

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (PostgreSQL) ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=murihspace
DB_USERNAME=postgres
DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting / Queue ──────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# ── Redis ─────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@murihspace.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / Storage (S3) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Contabo Object Storage (S3-compatible) ─────────────────────────
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
CONTABO_REGION=eu-central-1
CONTABO_BUCKET=
CONTABO_ENDPOINT=https://eu2.contabostorage.com
CONTABO_URL=
CONTABO_USE_PATH_STYLE_ENDPOINT=true

# ── Private files disk (digital products, etc.) ─────────────────────
FILESYSTEM_PRIVATE_DISK=local

# ── KYC (identity verification) ─────────────────────────────────────
# Providers available to users (comma-separated). The admin can override this
# per-install from Admin → Settings → KYC providers. Options: didit | sumsub | manual.
# Enable one or both automated providers together (ID check + liveness).
KYC_PROVIDERS=manual
# Legacy single-provider alias (used if KYC_PROVIDERS is empty).
KYC_PROVIDER=manual
KYC_REQUIRED_FOR_SELLERS=true
KYC_SESSION_RATE_LIMIT=5
KYC_SESSION_RATE_LIMIT_MINUTES=60
KYC_DATA_RETENTION_DAYS=365

# Didit (hosted session verification)
DIDIT_ENABLED=false
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_CLIENT_ID=
DIDIT_CLIENT_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=
DIDIT_SANDBOX=true
DIDIT_TIMEOUT=20

# Sumsub (WebSDK verification — ID + liveness)
SUMSUB_ENABLED=false
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_TOKEN_TTL=600

# ── Phone OTP (Twilio Verify) ──────────────────────────────────────
# Phone verification is the default login/registration method. The driver
# sends codes and checks user-entered codes through Twilio Verify. Twilio
# secrets must never be exposed to the frontend.
#
# OTP_DRIVER selects the driver:
#   - twilio  real Twilio Verify (use in production)
#   - log     local dev/test driver that logs the code and stores it briefly
#             in the cache so local flows and automated tests can read it.
#             Never enable 'log' in production.
#
# Rate-limit / behaviour knobs. All default to safe values and can be tuned
# per environment.
OTP_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY=NG
TWILIO_OTP_CHANNEL=sms
TWILIO_OTP_ENABLED=false
OTP_CODE_TTL=10
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_NUMBER_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=10
OTP_MAX_PER_DEVICE_PER_HOUR=10
OTP_MAX_DAILY_PER_NUMBER=10
OTP_MAX_VERIFY_ATTEMPTS=5
# Comma-separated ISO2 country codes where OTP delivery is blocked.
OTP_BLOCKED_COUNTRIES=

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://murihspace.com,https://app.murihspace.com
CORS_SUPPORTS_CREDENTIALS=true

# ── Reverb (WebSockets) ───────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="app.murihspace.com"
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Sanctum ───────────────────────────────────────────────────────
# The API authenticates with Bearer tokens (no cookie/session auth),
# so stateful domains must stay empty to avoid forcing CSRF on API calls.
SANCTUM_STATEFUL_DOMAINS=

# Anthropic Claude API (AI assistant + onboarding)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# OpenAI / Google Gemini providers (admin can switch providers at runtime)
AI_PROVIDER=anthropic
AI_MAX_TOKENS=1024
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Platform-wide AI behavior defaults (per-creator overrides via the ai_settings UI)
ANTHROPIC_PERSONA=Mera
ANTHROPIC_TONE=Warm, friendly and practical. Encouraging without being generic.
ANTHROPIC_FOCUS_TOPICS=
ANTHROPIC_KEEP_ON_TOPIC=true
ANTHROPIC_OFF_TOPIC_MODE=redirect

# Server-side chat media retention (admin-overridable at runtime)
# Default retention window for chat media in days
MEDIA_RETENTION_DAYS=7
# Hard upper cap administrators cannot exceed
MEDIA_MAX_RETENTION_DAYS=365
# Master switch for the scheduled deletion job (true/false)
MEDIA_AUTO_DELETE=true
# Show "Available for X more days" warnings to users
MEDIA_EXPIRY_WARNING=true
# Days before expiry when a download-warning notification is triggered
MEDIA_EXPIRY_WARNING_DAYS=3
# How many media rows the cleanup command processes per run
MEDIA_DELETION_BATCH_SIZE=200
# Time of day the deletion job runs (24h "HH:MM")
MEDIA_DELETION_SCHEDULE=03:00
# Emit failure alerts when a deletion batch partially fails
MEDIA_DELETION_FAILURE_ALERTS=true

# ── Ticket / support service (marketing-backend) ─────
TICKET_SERVICE_BASE_URL=http://127.0.0.1:8123
TICKET_SERVICE_INTERNAL_TOKEN=change-me

# ── Support event sync (backend → marketing-backend webhook) ─
# Falls back to TICKET_SERVICE_* when unset. Events are dispatched as queued
# webhooks (X-Internal-Token + timestamp + nonce) and stored idempotently.
SUPPORT_EVENTS_BASE_URL=
SUPPORT_EVENTS_INTERNAL_TOKEN=
SUPPORT_EVENTS_ENABLED=true

# ── Legacy support threads (retiring) ─
# Old support_threads message POST is enabled by default for rollback safety.
# Set to false once the new /api/v1/tickets flow is verified in production.
LEGACY_SUPPORT_THREADS_ENABLED=true

# ── Internal service API (marketing-backend → backend) ───
INTERNAL_API_TOKEN=change-me-internal
INTERNAL_API_ALLOWED_IPS=
INTERNAL_API_RATE_LIMIT=300
