APP_NAME=MurihSpace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://murihspace.com
FRONTEND_URL=https://app.murihspace.com
APP_DOWNLOAD_URL=https://apps.apple.com/app/murihspace

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (PostgreSQL) ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=murihspace
DB_USERNAME=postgres
DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting / Queue ──────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# ── Redis ─────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@murihspace.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / Storage (S3) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Contabo Object Storage (S3-compatible) ─────────────────────────
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
CONTABO_REGION=eu-central-1
CONTABO_BUCKET=
CONTABO_ENDPOINT=https://eu2.contabostorage.com
CONTABO_URL=
CONTABO_USE_PATH_STYLE_ENDPOINT=true

# ── Private files disk (digital products, etc.) ─────────────────────
FILESYSTEM_PRIVATE_DISK=local

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://murihspace.com,https://app.murihspace.com
CORS_SUPPORTS_CREDENTIALS=true

# ── Reverb (WebSockets) ───────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="app.murihspace.com"
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Sanctum (SPA Auth Domains) ────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=murihspace.com,app.murihspace.com

# Anthropic Claude API (AI assistant + onboarding)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# OpenAI / Google Gemini providers (admin can switch providers at runtime)
AI_PROVIDER=anthropic
AI_MAX_TOKENS=1024
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Platform-wide AI behavior defaults (per-creator overrides via the ai_settings UI)
ANTHROPIC_PERSONA=Mera
ANTHROPIC_TONE=Warm, friendly and practical. Encouraging without being generic.
ANTHROPIC_FOCUS_TOPICS=
ANTHROPIC_KEEP_ON_TOPIC=true
ANTHROPIC_OFF_TOPIC_MODE=redirect
