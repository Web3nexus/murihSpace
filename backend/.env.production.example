APP_NAME=MurihSpace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.murihspace.com

DB_CONNECTION=pgsql
DB_HOST=aws-postgres.murihspace.internal
DB_PORT=5432
DB_DATABASE=murihspace_prod
DB_USERNAME=murihspace_app
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis.murihspace.internal
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

DEFAULT_CURRENCY=NGN

# ── Airwallex Production ──
AIRWALLEX_ENABLED=true
AIRWALLEX_ENV=production
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_TIMEOUT=30

# ── Paystack Production ──
PAYSTACK_ENABLED=true
PAYSTACK_ENV=live
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_TIMEOUT=30

# ── Flutterwave Production (v3) ──
# Live keys come from the dashboard with Test mode OFF:
#   FLWPUBK_PROD-* / FLWSECK_PROD-* / Encryption Key / Secret Hash
# Test and live share the host https://api.flutterwave.com/v3 — only keys differ.
# Webhook URL: {APP_URL}/api/v1/webhooks/flutterwave
# Return/callback: PAYMENT_RETURN_URL below.
# FLUTTERWAVE_ENCRYPTION_KEY is only needed for Flutterwave Inline JS; the
# server-side POST /v3/payments redirect flow does not read it.
FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_ENV=live
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_TIMEOUT=30

# ── Paddle Production (Merchant of Record) ──
# Paddle sandbox/live are separate hosts, so PADDLE_ENV matters here.
# Webhook URL: {APP_URL}/api/v1/webhooks/paddle
PADDLE_ENABLED=false
PADDLE_ENV=production
PADDLE_HANDLES_TAX=true
PADDLE_VENDOR_ID=
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_PUBLIC_KEY=
PADDLE_TIMEOUT=30

# ── Stripe Production (config/stripe.php) ──
# Webhook URL: {APP_URL}/api/v1/webhooks/stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Post-payment return URL ──
# Where the provider sends the customer back. Falls back to
# {FRONTEND_URL}/wallet?payment=return when blank.
# {reference} interpolates the internal payment reference.
PAYMENT_RETURN_URL=https://web.murihspace.com/wallet?payment=return&ref={reference}

PAYMENT_WEBHOOK_TOLERANCE=300
PAYMENT_WEBHOOK_QUEUE=payments

