# ── Ads Frontend (Vite / React Router) ─────────────────────────────────
# Copy to .env for local development. Production builds fail unless
# VITE_ADS_API_URL and VITE_MAIN_APP_URL are set in the build environment.

# Ads API (ads-backend) host, without a trailing /api.
VITE_ADS_API_URL=http://127.0.0.1:8002

# Origin of the MurihSpace main app ("Continue with MurihSpace" and pixel script).
VITE_MAIN_APP_URL=http://localhost:5173

# ── Production values (set in the build environment, not committed) ─────
# VITE_ADS_API_URL=https://<ads-api-host>
# VITE_MAIN_APP_URL=https://<main-app-host>
