# ── Frontend Dashboard (Vite) ──────────────────────────────────────
# Required
VITE_APP_NAME=MurihSpace
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_GRAPH_API_URL=http://127.0.0.1:8090/v1
VITE_MARKETING_URL=http://localhost:3000
VITE_ADS_API_URL=http://127.0.0.1:8002/api

# Help Center API (marketing-backend public help endpoints, e.g. http://127.0.0.1:8080/api/public/help).
# Leave blank to keep using the bundled static help snapshot (rollback-safe fallback).
VITE_HELP_API_URL=

# Reverb / WebSockets (optional, leave blank if unused)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ── Production Overrides ───────────────────────────────────────────
# VITE_API_BASE_URL=https://api.murihspace.com/api/v1
# VITE_API_URL=https://api.murihspace.com/api/v1
# VITE_GRAPH_API_URL=https://graph.murihspace.com/v1
# VITE_MARKETING_URL=https://murihspace.com
# VITE_ADS_API_URL=https://ads.murihspace.com/api
# VITE_REVERB_HOST=api.murihspace.com

# ── Universal Links / App Links association files ─────────────────
# Read by scripts/generate-association-files.mjs (`npm run links:write`).
# Both values are published in the association files themselves, so neither
# is a secret — they identify which app may claim which URLs.
#
# iOS Apple Team ID (Developer Portal → Membership). Apple compares it against
# the team that signed the installed app, so a placeholder here means every
# Universal Link opens in Safari instead. 10 characters, e.g. ABCDE12345.
IOS_TEAM_ID=
# SHA-256 of the certificate the Android release build is signed with:
#   keytool -list -v -keystore upload-keystore.jks -alias upload | grep -i sha256
# With Play App Signing, use the app-signing key from Play Console →
# Setup → App integrity, not the upload key.
ANDROID_FINGERPRINT=
ANDROID_PACKAGE=com.murihspace.mobile
IOS_BUNDLE_ID=com.murihspace.mobile
