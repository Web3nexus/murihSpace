# ── Marketing Site (React Router / Vite) ──────────────────────────
VITE_SITE_NAME=MurihSpace
VITE_SITE_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_HELP_API_URL=http://127.0.0.1:8123/api/public/help

# ── Store / installer links (download page) ────────────────────────
# Only platforms with a URL are rendered; leave blank to show "Coming soon".
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.murihspace.app
# VITE_APK_URL=https://downloads.murihspace.com/murihspace.apk
# VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000
# VITE_MACOS_URL=https://downloads.murihspace.com/murihspace.dmg
# VITE_WINDOWS_URL=https://apps.microsoft.com/detail/murihspace

# ── Production / Staging Overrides ─────────────────────────────────
# VITE_SITE_URL=https://murihspace.com
# VITE_APP_URL=https://web.murihspace.com # or https://staging.murihspace.com
# VITE_WEB_CLIENT_URL=https://web.murihspace.com # or https://staging.murihspace.com
# VITE_API_BASE_URL=https://api.murihspace.com/api/v1
# VITE_HELP_API_URL=https://support-api.murihspace.com/api/public/help
# Origin of the Ads Manager app. Its /login page is the target of every Ads Manager button.
# VITE_ADS_MANAGER_URL=https://<ads-app-host>
# ── Hidden staff sign-in (not linked anywhere on the site) ─────────
# Path segment for the staff login page. Set at BUILD time (routes are fixed at build).
# Use 16 to 128 characters of letters, digits, '-' or '_'. Do not rely on the built-in default in production:
# it is in the source, and the path is visible in the client bundle either way.
# STAFF_LOGIN_PATH=
# Base URL of the marketing backend that serves POST /api/staff/login (server-side only).
# STAFF_API_URL=
