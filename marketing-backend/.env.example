APP_NAME="MurihSpace Support"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://app.murihspace.com
MARKETING_URL=https://murihspace.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL — separate support DB) ────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=murihspace_support
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@murihspace.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Contabo Object Storage (S3-compatible)
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
CONTABO_REGION=eu-central-1
CONTABO_BUCKET=
CONTABO_ENDPOINT=https://eu2.contabostorage.com
CONTABO_URL=
CONTABO_USE_PATH_STYLE_ENDPOINT=true

# ── Sanctum (Bearer tokens, no cookie/session auth) ────────────
SANCTUM_STATEFUL_DOMAINS=

# ── Internal service API (main backend link) ───────────────────
# Shared secret used to authenticate service-to-service calls.
INTERNAL_API_SECRET=
MAIN_BACKEND_INTERNAL_URL=https://api.murihspace.com
# Token for the main backend's internal API (must match backend's INTERNAL_API_TOKEN).
MAIN_BACKEND_INTERNAL_TOKEN=change-me-internal

VITE_APP_NAME="${APP_NAME}"