APP_NAME="MurihSpace Ads API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of this API, and of the advertiser dashboard it serves sign-in to.
# Required in production (the app refuses to boot without them). No fallback domain.
APP_URL=http://localhost:8002
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Core (main MurihSpace) database. The product-catalog read path connects here
# directly. Database, username and password are required (no fallback to this
# service's own credentials); host and port default to localhost.
# DB_CORE_HOST=127.0.0.1
# DB_CORE_PORT=5432
DB_CORE_DATABASE=
DB_CORE_USERNAME=
DB_CORE_PASSWORD=

# Ads staff sign-in from the marketing hub. The hub signs short-lived staff tokens with
# this shared secret (HMAC-SHA256). Required in production. Unset = staff sign-in refused.
ADS_STAFF_HUB_SECRET=
# Lifetime of an ads admin session created from a staff token (minutes).
# ADS_STAFF_SESSION_MINUTES=480

# "Continue with MurihSpace" (browser SSO). The browser gets a single-use code from the main
# API; this service exchanges it server-to-server. Secrets stay server-side.
# MURIHSPACE_SSO_BASE_URL: ORIGIN of the main backend (no /api), e.g. https://<main-api-host>
# MURIHSPACE_INTERNAL_TOKEN: the main backend's INTERNAL_API_TOKEN value
# MURIHSPACE_SSO_REDIRECT_URI: the ads frontend callback, e.g. https://<ads-frontend-host>/auth/sso/callback
#   (must equal the main backend's ADS_SSO_REDIRECT_URI exactly)
# All three are required in production.
MURIHSPACE_SSO_BASE_URL=
MURIHSPACE_INTERNAL_TOKEN=
MURIHSPACE_SSO_REDIRECT_URI=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Required in production (no default).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
